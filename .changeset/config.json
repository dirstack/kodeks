{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": [
    "@dirstack/kodeks/changesets-changelog",
    {
      "repo": "dirstack/kodeks"
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "changedFilePatterns": [
    "cli/**",
    "configs/**",
    "skills/**",
    ".github/workflows/public-*.yml",
    "package.json",
    "!**/*.test.ts"
  ]
}
