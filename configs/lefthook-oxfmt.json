{
  "$schema": "https://json.schemastore.org/lefthook.json",
  "pre-commit": {
    "parallel": true,
    "commands": {
      "format:oxfmt": {
        "glob": "*.{ts,tsx,js,jsx,json,jsonc,css}",
        "exclude": "\\.gen\\.ts$|\\.generated/",
        "run": "bunx oxfmt --write {staged_files}",
        "stage_fixed": true
      }
    }
  }
}
