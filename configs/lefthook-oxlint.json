{
  "$schema": "https://json.schemastore.org/lefthook.json",
  "pre-commit": {
    "parallel": true,
    "commands": {
      "lint:oxlint": {
        "glob": "*.{ts,tsx,js,jsx}",
        "exclude": "\\.gen\\.ts$|\\.generated/",
        "run": "bunx oxlint --fix {staged_files}",
        "stage_fixed": true
      }
    }
  }
}
